{
  "name": "hades",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "summon": "npm run summon -w @hades/engine --",
    "test:props:full": "cross-env HADES_PROPERTY_RUNS=20 HADES_PROPERTY_TIMEOUT_MS=900000 npm run test -w @hades/engine -- test/properties.test.ts"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
